{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "mutate": [
    "src/utils/soroban.ts",
    "src/utils/contract-stats.ts",
    "src/utils/governance.ts",
    "src/lib/contract-events.ts",
    "src/lib/contract-event-stream-state.ts",
    "src/lib/contract/**/*.ts",
    "!src/**/*.d.ts",
    "!src/**/*.stories.ts",
    "!src/**/*.test.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "json", "text", "text-summary"],
  "htmlReporter": {
    "fileName": "mutation-report/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 60,
    "break": 90
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "plugins": ["@stryker-mutator/core", "@stryker-mutator/vitest-runner"]
}
